<mxfile host="app.diagrams.net"><diagram id="design-flow" name="design-flow"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="設計の流れ — コードを書く前に決める" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="700" height="30" as="geometry"/></mxCell><mxCell id="c2" value="要件&lt;br&gt;(実務風の依頼文)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="165" height="70" as="geometry"/></mxCell><mxCell id="c3" value="① 画面を部品に分解&lt;br&gt;&lt;font style='font-size:11px'&gt;スケッチに線を引く&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215" y="70" width="165" height="70" as="geometry"/></mxCell><mxCell id="c4" value="② 契約を決める&lt;br&gt;&lt;font style='font-size:11px'&gt;Input / Output だけ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="165" height="70" as="geometry"/></mxCell><mxCell id="c5" value="③ 状態の置き場所&lt;br&gt;&lt;font style='font-size:11px'&gt;誰が持つ? 導出できる?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="605" y="70" width="165" height="70" as="geometry"/></mxCell><mxCell id="c6" value="④ 骨組み → 実装&lt;br&gt;&lt;font style='font-size:11px'&gt;常に動く状態で進む&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="70" width="165" height="70" as="geometry"/></mxCell><mxCell id="c7" value="⑤ 保存して&lt;br&gt;ブラウザで確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="995" y="70" width="165" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;①〜③は紙に書いてから&lt;/b&gt;コードに向かう。&lt;br&gt;書けない=まだ設計が決まっていないサイン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="455" height="55" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;部品を切る/切らないの3基準&lt;/b&gt;: ①2箇所以上で使う見込み ②単体で名前が付く ③親の事情を知らずに動く&lt;br&gt;1つも満たさないなら切らない(切らないのも設計判断)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="495" y="165" width="665" height="55" as="geometry"/></mxCell><mxCell id="c15" value="成果物: コンポーネントツリーと契約" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="255" width="600" height="30" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;App(親)&lt;/b&gt;&lt;br&gt;状態: query / favoriteIds&lt;br&gt;導出: filtered = computed(...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="320" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;SearchBox&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;検索語を通知するだけ。&lt;br&gt;絞り込み方は知らない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="500" width="250" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;PokemonCard × N&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;表示と通知だけ。&lt;br&gt;お気に入り一覧は持たない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="790" y="500" width="270" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Output: queryChange(検索語)" style="rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;fontSize=12;fontColor=#b06000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a55a0;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="Input: [pokemon] [favorite]" style="edgeLabel;html=1;align=center;fontSize=12;" vertex="1" connectable="0" parent="c20"><mxGeometry x="0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c22" value="" style="rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;fontSize=12;fontColor=#b06000;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.95;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Output: (favoriteToggle)=id" style="edgeLabel;html=1;align=center;fontSize=12;" vertex="1" connectable="0" parent="c22"><mxGeometry x="0.55" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c24" value="鉄則: 親は子の中身を知らない・子は親の存在を知らない。契約(Input / Output)だけでつながっているから、部品はどの画面でも使い回せる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="615" width="1140" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>